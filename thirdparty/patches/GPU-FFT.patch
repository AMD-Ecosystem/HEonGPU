diff --git a/CMakeLists.txt b/CMakeLists.txt
index 485ae3d..a60014c 100755
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -5,11 +5,20 @@
 
 cmake_minimum_required(VERSION 3.26)
 
-if(NOT DEFINED CMAKE_CUDA_ARCHITECTURES OR CMAKE_CUDA_ARCHITECTURES STREQUAL "")
+if(USE_HIP)
+    if(NOT DEFINED CMAKE_HIP_ARCHITECTURES OR CMAKE_HIP_ARCHITECTURES STREQUAL "")
+        set(CMAKE_HIP_ARCHITECTURES gfx90a CACHE STRING "HIP GPU architectures" FORCE)
+    endif()
+elseif(NOT DEFINED CMAKE_CUDA_ARCHITECTURES OR CMAKE_CUDA_ARCHITECTURES STREQUAL "")
     set(CMAKE_CUDA_ARCHITECTURES 80;86;89;90 CACHE STRING "CUDA GPU architectures" FORCE)
 endif()
 
-project(GPUFFT VERSION 1.0 LANGUAGES C CXX CUDA ASM)
+option(USE_HIP "Build with HIP for AMD GPUs" OFF)
+if(USE_HIP)
+    project(GPUFFT VERSION 1.0 LANGUAGES C CXX HIP)
+else()
+    project(GPUFFT VERSION 1.0 LANGUAGES C CXX CUDA ASM)
+endif()
 
 if(NOT CMAKE_BUILD_TYPE OR CMAKE_BUILD_TYPE STREQUAL "")
   set(CMAKE_BUILD_TYPE Release CACHE STRING "Build type (Debug or Release)" )
@@ -32,7 +41,9 @@ set(CMAKE_CXX_FLAGS_RELEASE "${CMAKE_CXX_FLAGS_RELEASE} -O3")
 set(CMAKE_CUDA_FLAGS_DEBUG   "${CMAKE_CUDA_FLAGS_DEBUG} -g")
 set(CMAKE_CUDA_FLAGS_RELEASE "${CMAKE_CUDA_FLAGS_RELEASE} -O3")
 
-find_package(CUDAToolkit REQUIRED)
+if(NOT USE_HIP)
+    find_package(CUDAToolkit REQUIRED)
+endif()
 message(STATUS "Setting CMAKE_CUDA_ARCHITECTURES to ${CMAKE_CUDA_ARCHITECTURES} for GPUFFT")
 
 ##################
