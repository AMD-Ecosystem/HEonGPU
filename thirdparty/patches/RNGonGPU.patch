--- a/src/include/rngongpu/common/aes.cuh
+++ b/src/include/rngongpu/common/aes.cuh
@@ -18,6 +18,7 @@
 #include <string>
 #include <cuda_runtime.h>
 #include <algorithm>
+#include <type_traits>
 #include "gpuntt/common/modular_arith.cuh"
 
 typedef unsigned char Data8;
@@ -610,6 +611,20 @@ namespace rngongpu
 
     __device__ Data64 reverseBytesULL(Data64 x);
 
+    // Truncates a signed Gaussian sample towards zero and reinterprets it as
+    // the unsigned residue type, so that adding the modulus turns a negative
+    // sample into its representative. Converting a negative floating-point
+    // value straight to an unsigned integer is undefined and the GPU back ends
+    // do not agree on it: one saturates the result to zero, the other keeps
+    // only the low 32 bits of the two's-complement value. Going through the
+    // signed type first makes the truncation well defined everywhere.
+    template <typename T, typename U>
+    __device__ __forceinline__ T truncate_signed(U value)
+    {
+        return static_cast<T>(
+            static_cast<typename std::make_signed<T>::type>(value));
+    }
+
 } // namespace rngongpu
 
 #endif // AES_H
