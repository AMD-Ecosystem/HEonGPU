include(CMakeFindDependencyMacro)

list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

if(NOT "@USE_HIP@")
    set(_HEONGPU_CUDA_PREFIX_CANDIDATES
        $ENV{CUDA_HOME}
        $ENV{CUDA_PATH}
        $ENV{CUDA_ROOT}
        ${CUDAToolkit_ROOT}
        ${CUDA_TOOLKIT_ROOT_DIR}
        /usr/local/cuda)
    foreach(_prefix IN LISTS _HEONGPU_CUDA_PREFIX_CANDIDATES)
        if(_prefix AND EXISTS "${_prefix}")
            list(APPEND CMAKE_PREFIX_PATH "${_prefix}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES CMAKE_PREFIX_PATH)
    unset(_HEONGPU_CUDA_PREFIX_CANDIDATES)
endif()

if("@USE_HIP@")
    find_dependency(hip REQUIRED)
    find_dependency(hiprand REQUIRED)
    find_dependency(rocthrust REQUIRED)
else()
    find_dependency(CUDAToolkit REQUIRED)
endif()

find_dependency(GPUNTT REQUIRED)
find_dependency(GPUFFT REQUIRED)
if("@USE_HIP@")
    # hipMM, which provides the rmm package on AMD GPUs, has its own version
    # numbers.
    find_dependency(rmm REQUIRED)
else()
    find_dependency(rmm 26.08 REQUIRED)
endif()
find_dependency(OpenSSL 1.1.1 REQUIRED COMPONENTS Crypto SSL)
find_dependency(RNGonGPU REQUIRED)
find_dependency(ZLIB REQUIRED)

if(NOT TARGET GMP::GMP)
    find_library(GMP_LIBRARY NAMES gmp)
    find_path(GMP_INCLUDE_DIR gmp.h)
    if(NOT GMP_LIBRARY OR NOT GMP_INCLUDE_DIR)
        message(FATAL_ERROR "GMP not found. Please install the GMP development package.")
    endif()
    add_library(GMP::GMP UNKNOWN IMPORTED)
    set_target_properties(GMP::GMP PROPERTIES
        IMPORTED_LOCATION ${GMP_LIBRARY}
        INTERFACE_INCLUDE_DIRECTORIES ${GMP_INCLUDE_DIR}
    )
endif()

# NTL is linked privately, but a static HEonGPU still needs it at link time.
if(NOT TARGET NTL::NTL)
    find_library(NTL_LIBRARY NAMES ntl)
    if(NOT NTL_LIBRARY)
        message(FATAL_ERROR "NTL not found. Please install the NTL development package.")
    endif()
    add_library(NTL::NTL UNKNOWN IMPORTED)
    set_target_properties(NTL::NTL PROPERTIES
        IMPORTED_LOCATION ${NTL_LIBRARY}
        INTERFACE_LINK_LIBRARIES GMP::GMP
    )
endif()

include("${CMAKE_CURRENT_LIST_DIR}/@HEonGPU_TARGETS_EXPORT_NAME@.cmake")
